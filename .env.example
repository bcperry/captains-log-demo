# Captain's Log - Unified Environment Configuration
# Copy this file to .env and update with your values
# This single .env file configures both backend (FastAPI) and frontend (Vite)

# =============================================================================
# Azure Cloud Environment (shared by backend and frontend)
# =============================================================================
# Options: commercial, government, local
AZURE_CLOUD=government

# =============================================================================
# Azure Entra ID (Authentication) - Shared Configuration
# =============================================================================
# These values are used by both backend and frontend
# The VITE_ prefixed versions are for the Vite frontend build

# Azure Entra ID tenant ID
AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Azure Entra ID application (client) ID
AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_CLIENT_ID=your-client-id-here

# Azure cloud for frontend (commercial or government)
VITE_AZURE_CLOUD=government

# =============================================================================
# Frontend Configuration (VITE_ prefix required for Vite)
# =============================================================================
# Backend API URL (leave empty in production, frontend uses same origin)
# VITE_API_BASE_URL=http://localhost:8001

# Redirect URI after authentication (defaults to window.location.origin in production)
# VITE_AZURE_REDIRECT_URI=http://localhost:3000

# =============================================================================
# Azure Speech Services (Backend only)
# =============================================================================
# Required for audio transcription functionality

# Azure Speech Service subscription key
AZURE_SPEECH_KEY=your-speech-service-key-here

# Azure Speech Service region
# Commercial: eastus, westus2, etc.
# Government: usgovvirginia, usgovarizona
AZURE_SPEECH_REGION=usgovvirginia

# Optional: Custom Speech Service endpoint (auto-generated if not provided)
# AZURE_SPEECH_ENDPOINT=https://your-speech-service.cognitiveservices.azure.us/

# =============================================================================
# Azure OpenAI (Backend only)
# =============================================================================
# Required for AI-powered analysis features

# Azure OpenAI endpoint URL
# AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/

# Azure OpenAI API key
# AZURE_OPENAI_KEY=your-openai-key-here

# Azure OpenAI deployment name (e.g., gpt-4, gpt-35-turbo)
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# Azure Cosmos DB (Backend only)
# =============================================================================
# Required for data persistence

# Azure Cosmos DB endpoint URL
# AZURE_COSMOS_ENDPOINT=https://your-cosmosdb.documents.azure.com:443/

# Azure Cosmos DB key
# AZURE_COSMOS_KEY=your-cosmos-key-here

# Azure Cosmos DB database name
AZURE_COSMOS_DATABASE=captainslog

# =============================================================================
# Azure Blob Storage (Backend only)
# =============================================================================
# Required for saving audio files before batch transcription

# Azure Storage account name (used with managed identity)
# AZURE_STORAGE_ACCOUNT=your-storage-account-name

# Azure Storage container name (defaults to audio-uploads)
AZURE_STORAGE_CONTAINER=audio-uploads

# Optional: Azure Storage endpoint URL (auto-generated if not provided)
# AZURE_STORAGE_ENDPOINT=https://your-storage-account.blob.core.usgovcloudapi.net

# Optional: Connection string (alternative to managed identity)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# =============================================================================
# Backend-Only Azure Entra ID Settings
# =============================================================================
# Azure Entra ID client secret (for service-to-service auth, optional)
# AZURE_CLIENT_SECRET=your-client-secret-here

# Optional: Separate client ID for Swagger UI OAuth (defaults to AZURE_CLIENT_ID)
# Use this if you have a separate app registration for the Swagger UI
# OPENAPI_CLIENT_ID=your-swagger-client-id-here

# =============================================================================
# Application Settings (Backend only)
# =============================================================================
APP_NAME=Captains Log
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# CORS Settings (Backend only)
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
